# Copy this file to .env for local use. Never commit .env or credentials.

# Keep disabled unless an intentional smoke test is running.
NOTIFICATION_ROUTER_API_ENABLED=0
NOTIFICATION_ROUTER_PROVIDER=gemini
NOTIFICATION_ROUTER_GEMINI_BACKEND=vertex

# Vertex AI: use ADC or a local service-account file.
NOTIFICATION_ROUTER_GEMINI_VERTEX_PROJECT=<google-cloud-project>
NOTIFICATION_ROUTER_GEMINI_VERTEX_LOCATION=<google-cloud-region>
NOTIFICATION_ROUTER_GEMINI_VERTEX_AUTH=adc
# NOTIFICATION_ROUTER_GEMINI_VERTEX_CREDENTIALS_FILE=<local-json-path>

# AI Studio alternative: select explicitly and provide the key in your shell.
# NOTIFICATION_ROUTER_GEMINI_BACKEND=ai-studio
# NOTIFICATION_ROUTER_GEMINI_API_KEY_ENV=NOTIFICATION_ROUTER_GEMINI_API_KEY
# NOTIFICATION_ROUTER_GEMINI_API_KEY=<set-only-in-your-local-environment>

NOTIFICATION_ROUTER_EXTRACTION_MODEL=<explicit-multimodal-model>
NOTIFICATION_ROUTER_ROUTING_MODEL=<explicit-routing-model>
NOTIFICATION_ROUTER_TIMEOUT_SECONDS=30
NOTIFICATION_ROUTER_MAX_RETRIES=1
NOTIFICATION_ROUTER_RETRY_BACKOFF_SECONDS=0
NOTIFICATION_ROUTER_CONCURRENCY=1
NOTIFICATION_ROUTER_COST_LIMIT_USD=0.10
NOTIFICATION_ROUTER_PER_CALL_COST_LIMIT_USD=0.05
NOTIFICATION_ROUTER_INPUT_COST_PER_1K=0
NOTIFICATION_ROUTER_OUTPUT_COST_PER_1K=0
